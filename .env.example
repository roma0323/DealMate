# Copy this file to .env and fill in the values. Never commit .env.

# Your ngrok static domain, without https:// (e.g. dealmate-xxxx.ngrok-free.app)
PUBLIC_HOST=

# Team Gmail account + app password for notifications (optional: without them, emails are only logged)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# 1 = browse_listings also shows private data (emails, wants, questions, deals) for debugging.
# Turn off (0) before other people use the connector or for the demo.
DEALMATE_DEBUG=0
