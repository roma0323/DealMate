# Copy this file to .env and fill in the values. Never commit .env.

# Your ngrok static domain, without https:// (e.g. dealmate-xxxx.ngrok-free.app)
PUBLIC_HOST=

# Anthropic API key for the agents' wording (optional: without it, fixed template text is used)
ANTHROPIC_API_KEY=

# Team Gmail account + app password for notifications (optional: without them, emails are only logged)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
